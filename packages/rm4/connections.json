{
  "namespace": "komtas-rm4",
  "context": "docker-desktop",
  "services": [
    {
      "id": "postgres",
      "name": "PostgreSQL",
      "service": "postgres",
      "localPort": 15435,
      "remotePort": 5432,
      "kind": "tcp",
      "path": "",
      "database": "komtas_rm4",
      "username": "rm4_bi"
    },
    {
      "id": "docs",
      "name": "dbt dokumani",
      "service": "dbt-docs",
      "localPort": 18084,
      "remotePort": 8080,
      "kind": "http",
      "path": "/static_index.html",
      "database": "",
      "username": ""
    },
    {
      "id": "cube",
      "name": "Cube REST API",
      "service": "cube",
      "localPort": 4004,
      "remotePort": 4000,
      "kind": "http",
      "path": "/cubejs-api/v1/meta",
      "database": "",
      "username": ""
    },
    {
      "id": "dashboard",
      "name": "Streamlit",
      "service": "dashboard",
      "localPort": 8504,
      "remotePort": 8501,
      "kind": "http",
      "path": "/",
      "database": "",
      "username": ""
    }
  ],
  "credentials": [
    {
      "name": "PostgreSQL parola",
      "secret": "rm4-credentials",
      "key": "bi-password"
    }
  ],
  "external": [],
  "cubeToken": true,
  "notes": [
    "Connect tum yerel tunelleri acar; dolu portta 30 sonraki port denenir. Gercek adresleri bu ozet gosterir.",
    "Ctrl+C yalniz bu Connect oturumunun actigi tunelleri kapatir; Kubernetes servislerini silmez.",
    "Cube API JWT ister. Cube Store kume ici destek servisidir, kullanici UI yoktur."
  ]
}
